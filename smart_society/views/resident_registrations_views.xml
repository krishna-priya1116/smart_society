<odoo>

    <record id="view_resident_registrations_list" model="ir.ui.view">
        <field name="name">resident.registrations.list</field>
        <field name="model">resident.registrations</field>

        <field name="arch" type="xml">
            <list>
                <!--                <field name="name"/>-->
                <field name="partner_id"/>
                <field name="mobile_number"/>
                <field name="user_id"/>
                <field name="email"/>
                <field name="flat_id"/>
                <!--               domain="[('flat_status','=','vacant')]" <field name="vehicle_count" optional="hide"/>-->
                <field name="id_proof" optional="hide"/>
                <field name="emergency_contacts" optional="hide"/>
                <field name="resident_type" optional="hide"/>
            </list>
        </field>
    </record>


    <record id="view_visitor_registartions_list" model="ir.ui.view">
        <field name="name">visitor.registrations.list</field>
        <field name="model">visitor.registrations</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mobile_number"/>
                <field name="has_vehicle"/>
            </list>
        </field>
    </record>


    <record id="view_visitor_registartions_form" model="ir.ui.view">
        <field name="name">visitor.registrations.form</field>
        <field name="model">visitor.registrations</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="mobile_number"/>
                        <field name="has_vehicle"/>
                        <field name="vehicle_number" invisible="not has_vehicle"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="view_resident_registration_form" model="ir.ui.view">
        <field name="name">resident.registrations.form</field>
        <field name="model">resident.registrations</field>
        <!--        <field name="domain">[('user_id', 'in', to_committee.ids)]</field>-->
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <!--                        <field name="name"/>-->
                        <group>
                            <field name="partner_id"/>
                            <field name="age"/>
                            <field name="user_id"/>
                            <field name="mobile_number"/>
                            <field name="email"/>
                            <field name="flat_id"/>
                            <field name="tower_id"/>
                        </group>
                        <group>
                            <field name="has_vehicle"/>
                            <field name="vehicle_count" invisible="not has_vehicle"/>
                            <field name="id_proof"/>
                            <field name="emergency_contacts"/>
                            <field name="resident_type"/>
                            <field name="real_owner" invisible="resident_type not in ['tenant','temporary_resident']"/>
                            <field name="tenant_certificate" invisible="resident_type not in 'tenant'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="vehicle details" invisible="not has_vehicle">
                            <field name="vehicle_ids">
                                <list editable="bottom">
                                    <field name="vehicle_number"/>
                                    <field name="vehicle_type"/>
                                    <field name="color"/>
                                    <!--                                    <field name="is_inside"/>-->
                                    <!--                                    <field name="parking_slot_id"/>-->
                                </list>
                            </field>
                        </page>
                        <!--                        <page string="vehicle allocation" invisible="not has_vehicle">-->
                        <!--                            <field name="vehicle_allocation_ids">-->
                        <!--                                <list editable="bottom">-->
                        <!--                                    <field name="resident_id"/>-->
                        <!--                                    <field name="vehicle_ids"/>-->
                        <!--                                    <field name="parking_slot"/>-->
                        <!--                                    <field name="security_id"/>-->
                        <!--                                </list>-->
                        <!--                            </field>-->
                        <!--                        </page>-->
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_security_guard_list" model="ir.ui.view">
        <field name="name">security.guard.list</field>
        <field name="model">security.guard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="security_id"/>
                <field name="tower_id"/>
                <field name="mobile_number"/>
                <field name="email"/>
                <field name="age" optional="hide"/>
<!--                <field name="aadhaar_number" optional="hide"/>-->
<!--                <field name="pan_number" optional="hide"/>-->
                <field name="address" optional="hide"/>
                <field name="working_hours_id"/>
            </list>
        </field>
    </record>

    <record id="view_security_guard_form" model="ir.ui.view">
        <field name="name">security.guard.form</field>
        <field name="model">security.guard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_new_security" type="object" string="New"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tower_id"/>
                            <field name="security_id"/>
                            <field name="mobile_number"/>
                            <field name="email"/>
                            <field name="age"/>
                            <field name="address"/>

                        </group>
                        <group string="Security Documents">
                            <field name="aadhaar_card_copy"/>
                            <field name="pan_card_copy"/>
                            <field name="police_verification_proof"/>
                        </group>
                        <group string="work Related">
                            <field name="working_hours_id"/>
                            <field name="join_date"/>
                            <field name="leave_date"/>
                            <field name="state"/>
                        </group>


                    </group>
                    <notebook>
                        <page string="Security History">
                            <field name="security_history_ids">
                                <list editable="bottom">
                                    <field name="security_guard_id"/>
                                    <field name="security_id"/>
                                    <field name="tower_id"/>
                                    <field name="mobile_number"/>
                                    <field name="email"/>
                                    <field name="age"/>
                                    <field name="aadhaar_card_copy"/>
                                    <field name="pan_card_copy"/>
                                    <field name="police_verification_proof"/>
                                    <field name="leave_date"/>
                                </list>
                            </field>
                        </page>

                        <page string="Security Documents">
                            <field name="security_documents_ids">
                                <list editable="bottom">
                                    <field name="security_guard_id"/>
                                    <field name="security_id"/>
                                    <field name="aadhaar_card_copy"/>
                                    <field name="pan_card_copy"/>
                                    <field name="police_verification_proof"/>
                                    <field name="mobile_number"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_security_document_form" model="ir.ui.view">
        <field name="name">security.guard.document.form</field>
        <field name="model">security.guard.document</field>
        <field name="arch" type="xml">
            <form>
                
            </form>
            <list>
                <field name="security_guard_id"/>
                <field name="security_id"/>
                <field name="aadhaar_card_copy"/>
                <field name="pan_card_copy"/>
                <field name="police_verification_proof"/>
                <field name="mobile_number"/>
            </list>
        </field>
    </record>


    <record id="hr_attendance_security_form_view" model="ir.ui.view">
        <field name="name">hr.attendance.form</field>
        <field name="model">hr.attendance</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <field name="overtime_status" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <xpath expr="//field[@id='employee_no_manager']" position="replace"/>
            <xpath expr="//field[@id='employee_manager']" position="replace"/>
            <xpath expr="//field[@id='employee_no_officer']" position="attributes">
                <attribute name="groups"/>
            </xpath>
            <field name="employee_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="check_in" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="check_out" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>


        </field>
    </record>

</odoo>

