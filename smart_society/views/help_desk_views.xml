    <record id="notice_board_list" model="ir.ui.view">
        <field name="name">notice.board.list</field>
        <field name="model">notice.board</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tower_id"/>
                <field name="create_date"/>
                <field name="description"/>
                <field name="help_desk_id"/>
            </list>
        </field>
    </record>


    <record id="notice_board_form" model="ir.ui.view">
        <field name="name">notice.board.form</field>
        <field name="model">notice.board</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="send_notice" type="object" string="Send" class="oe_stat_button"/>
                    <button name="cancel_notice" type="object" string="Cancel" class="oe_stat_button"/>
                    <button name="draft_notice" type="object" string="Draft" class="oe_stat_button"/>
                    <field name="stage" widget="statusbar" statusbar_visible="send,draft,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tower_id" widget="many2many_tags"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="help_desk_id" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="event_announcement_form" model="ir.ui.view">
        <field name="name">event.announcement.form</field>
        <field name="model">event.announcement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="send_event" type="object" string="Send" class="oe_stat_button"/>
                    <button name="cancel_event" type="object" string="Cancel" class="oe_stat_button"/>
                    <button name="draft_event" type="object" string="Draft" class="oe_stat_button"/>
                    <field name="stage" widget="statusbar" statusbar_visible="send,draft,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="tower_id" widget="many2many_tags"/>
                        </group>
                        <!--                        <field name="event_date" widget="date"/>-->
                        <group>
                            <field name="event_time_start"/>
                            <field name="event_time_end"/>
                            <field name="event_place"/>
                            <field name="society_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>