<odoo>
    <record id="help_desk_list" model="ir.ui.view">
        <field name="name">help.desk.list</field>
        <field name="model">help.desk</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tower_id"/>

            </list>
        </field>
    </record>

    <record id="help_desk_form" model="ir.ui.view">
        <field name="name">help.desk.form</field>
        <field name="model">help.desk</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tower_id"/>
                    </group>
                    <notebook>
                        <page string="Complaints">
                            <field name="complaint_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="create_date"/>
                                    <field name="flat_id"/>
                                    <field name="resident_id"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notice">
                            <field name="notice_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="tower_id"/>
                                    <field name="create_date"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="complaint_desk_list" model="ir.ui.view">
        <field name="name">complaint.desk.list</field>
        <field name="model">complaint.desk</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="resident_id"/>
                <field name="tower_id"/>
                <field name="flat_id"/>
                <field name="description" optional="hide"/>
                <field name="stage"/>
            </list>
        </field>
    </record>


    <record id="complaint_desk_form_view" model="ir.ui.view">
        <field name="name">complaint.desk.form</field>
        <field name="model">complaint.desk</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Action buttons — shown based on current stage -->
                    <button name="action_send"
                            string="Send Complaint"
                            type="object"
                            class="btn-primary"
                            invisible="stage != 'draft'"/>

                    <button name="action_process"
                            string="Mark On Process"
                            type="object"
                            class="btn-primary"
                            invisible="stage not in ('send', 'hold')"/>

                    <button name="action_hold"
                            string="Put On Hold"
                            type="object"
                            invisible="stage not in ('send', 'on_process')"/>

                    <button name="action_resolve"
                            string="Mark Resolved"
                            type="object"
                            class="btn-success"
                            invisible="stage not in ('on_process', 'hold')"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="stage in ('resolve', 'reject')"/>

                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="stage not in ('reject', 'hold')"/>

                    <field name="stage" widget="statusbar"
                           statusbar_visible="draft,send,on_process,resolve"
                           options="{'clickable': '0'}"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="resident_id"/>
                            <field name="flat_id"/>
                            <field name="tower_id"/>
                        </group>
                        <group>
                            <field name="to_committee"/>
                            <field name="help_desk_id"/>
                            <field name="description"/>
                            <field name="proof" widget="image"/>
                        </group>
                    </group>
                </sheet>

                <!--            <div class="oe_chatter">-->
                <!--                <field name="message_follower_ids"/>-->
                <!--                <field name="activity_ids"/>-->
                <!--                <field name="message_ids"/>-->
                <!--            </div>-->
            </form>
        </field>
    </record>
