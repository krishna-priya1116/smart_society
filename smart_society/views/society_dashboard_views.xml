                    <div class="emergency-section">
                        <div class="emergency-title">
                            Critical Alert System
                        </div>
                        <div class="row g-3">
                            <div class="col-lg-3 col-md-6">
                                <button type="object" name="sos_alerts" class="emergency-btn btn-sos">
                                    <div class="emergency-btn-content">
                                        <div class="emergency-btn-icon"/>
                                        <div class="emergency-btn-text">SOS ALERT</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <button type="object" name="fire_alerts" class="emergency-btn btn-fire">
                                    <div class="emergency-btn-content">
                                        <div class="emergency-btn-icon"/>
                                        <div class="emergency-btn-text">FIRE ALERT</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <button type="object" name="medical_panic_buttons" class="emergency-btn btn-medical">
                                    <div class="emergency-btn-content">
                                        <div class="emergency-btn-icon"/>
                                        <div class="emergency-btn-text">MEDICAL/PANIC</div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-lg-3 col-md-6">
                                <button type="object" name="emergency_broadcast" class="emergency-btn btn-broadcast"
                                        groups="smart_society.group_registration_committee,smart_society.group_registration_administration">
                                    <div class="emergency-btn-content">
                                        <div class="emergency-btn-icon"/>
                                        <div class="emergency-btn-text">BROADCAST</div>
                                    </div>
                                </button>
                            </div>
                        </div>
