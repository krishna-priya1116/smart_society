<odoo>
    <record id="view_dashboard_home_forms" model="ir.ui.view">
        <field name="name">society.dashboard.form</field>
        <field name="model">society.dashboard</field>
        <field name="arch" type="xml">
            <form string="Smart Society Dashboard">
                <sheet>
                    <style>
                        .dashboard-header-enhanced {
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
                        color: white;
                        padding: 40px;
                        border-radius: 16px;
                        margin-bottom: 30px;
                        box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
                        position: relative;
                        overflow: hidden;
                        }
                        .dashboard-header-enhanced::before {
                        content: '';
                        position: absolute;
                        top: -50%;
                        right: -10%;
                        width: 500px;
                        height: 500px;
                        background: rgba(255, 255, 255, 0.1);
                        border-radius: 50%;
                        animation: float 6s ease-in-out infinite;
                        }
                        @keyframes float {
                        0%, 100% { transform: translateY(0px); }
                        50% { transform: translateY(20px); }
                        }
                        .dashboard-header-content {
                        position: relative;
                        z-index: 1;
                        }
                        .dashboard-header-enhanced h1 {
                        margin: 0;
                        font-size: 40px;
                        font-weight: 800;
                        letter-spacing: -1px;
                        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
                        margin-bottom: 10px;
                        }
                        .dashboard-header-enhanced p {
                        margin: 0;
                        font-size: 16px;
                        opacity: 0.95;
                        font-weight: 500;
                        letter-spacing: 0.3px;
                        }
                        .header-stats {
                        display: flex;
                        gap: 30px;
                        margin-top: 20px;
                        padding-top: 20px;
                        border-top: 1px solid rgba(255, 255, 255, 0.2);
                        }
                        .header-stat-item {
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        }
                        .header-stat-icon {
                        width: 50px;
                        height: 50px;
                        background: rgba(255, 255, 255, 0.2);
                        border-radius: 10px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 24px;
                        backdrop-filter: blur(10px);
                        }
                        .header-stat-text h3 {
                        margin: 0;
                        font-size: 14px;
                        opacity: 0.85;
                        font-weight: 600;
                        text-transform: uppercase;
                        letter-spacing: 1px;
                        }
                        .header-stat-text p {
                        margin: 4px 0 0 0;
                        font-size: 18px;
                        font-weight: 700;
                        border: none;
                        }
                        .dashboard-header {
                        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                        color: white;
                        padding: 30px;
                        border-radius: 12px;
                        margin-bottom: 20px;
                        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                        }
                        .dashboard-header h1 {
                        margin: 0;
                        font-size: 32px;
                        font-weight: 700;
                        letter-spacing: -0.5px;
                        }
                        .dashboard-header p {
                        margin: 8px 0 0 0;
                        opacity: 0.95;
                        font-size: 14px;
                        }
                        .emergency-section {
                        margin-bottom: 30px;
                        }
                        .emergency-title {
                        font-size: 16px;
                        font-weight: 700;
                        color: #2d3436;
                        margin-bottom: 16px;
                        display: flex;
                        align-items: center;
                        gap: 8px;
                        }
                        .emergency-btn {
                        width: 100%;
                        height: 90px;
                        border: none;
                        border-radius: 14px;
                        font-weight: 700;
                        font-size: 15px;
                        cursor: pointer;
                        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        gap: 8px;
                        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
                        position: relative;
                        overflow: hidden;
                        }
                        .emergency-btn::before {
                        content: '';
                        position: absolute;
                        top: 0;
                        left: -100%;
                        width: 100%;
                        height: 100%;
                        background: rgba(255, 255, 255, 0.2);
                        transition: left 0.5s ease;
                        z-index: 0;
                        }
                        .emergency-btn:hover::before {
                        left: 100%;
                        }
                        .emergency-btn-content {
                        position: relative;
                        z-index: 1;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        gap: 6px;
                        }
                        .emergency-btn-icon {
                        font-size: 28px;
                        line-height: 1;
                        }
                        .emergency-btn-text {
                        font-size: 13px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        }
                        .btn-sos {
                        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);
                        color: white;
                        }
                        .btn-sos:hover {
                        transform: translateY(-6px);
                        box-shadow: 0 12px 32px rgba(255, 107, 107, 0.4);
                        }
                        .btn-fire {
                        background: linear-gradient(135deg, #ff8c42 0%, #ff6b35 100%);
                        color: white;
                        }
                        .btn-fire:hover {
                        transform: translateY(-6px);
                        box-shadow: 0 12px 32px rgba(255, 140, 66, 0.4);
                        }
                        .btn-medical {
                        background: linear-gradient(135deg, #ff6b9d 0%, #c44569 100%);
                        color: white;
                        }
                        .btn-medical:hover {
                        transform: translateY(-6px);
                        box-shadow: 0 12px 32px rgba(255, 107, 157, 0.4);
                        }
                        .btn-broadcast {
                        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
                        color: #2d3436;
                        }
                        .btn-broadcast:hover {
                        transform: translateY(-6px);
                        box-shadow: 0 12px 32px rgba(168, 237, 234, 0.4);
                        }


                        .stats-grid {
                        display: grid;
                        grid-template-columns: repeat(3, 1fr);
                        gap: 16px;
                        margin-bottom: 30px;
                        max-width: 600px;
                        }


                        .stat-card {
                        background: white;
                        border-radius: 12px;
                        padding: 16px;
                        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
                        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                        position: relative;
                        overflow: hidden;
                        }
                        .stat-card::before {
                        content: '';
                        position: absolute;
                        top: 0;
                        left: 0;
                        right: 0;
                        height: 3px;
                        background: linear-gradient(90deg, var(--color-start, #667eea), var(--color-end, #764ba2));
                        }
                        .stat-card:hover {
                        transform: translateY(-4px);
                        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
                        }
                        .stat-card-header {
                        display: flex;
                        justify-content: space-between;
                        align-items: flex-start;
                        gap: 8px;
                        }
                        .stat-card-icon {
                        width: 40px;
                        height: 40px;
                        border-radius: 8px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: 20px;
                        background: linear-gradient(135deg, var(--color-start, #667eea), var(--color-end, #764ba2));
                        color: white;
                        box-shadow: 0 2px 8px rgba(102, 126, 234, 0.2);
                        flex-shrink: 0;
                        }
                        .stat-card-value {
                        font-size: 24px;
                        font-weight: 800;
                        color: #2d3436;
                        line-height: 1;
                        background: linear-gradient(135deg, var(--color-start, #667eea), var(--color-end, #764ba2));
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        background-clip: text;
                        }
                        .stat-card-label {
                        font-size: 12px;
                        font-weight: 700;
                        color: #636e72;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                        margin-top: 8px;
                        }
                        .stat-card-desc {
                        font-size: 11px;
                        color: #95a5a6;
                        margin-top: 4px;
                        }
                        .stat-card:nth-child(1) { --color-start: #667eea; --color-end: #764ba2; }
                        .stat-card:nth-child(2) { --color-start: #f093fb; --color-end: #f5576c; }
                        .stat-card:nth-child(3) { --color-start: #4facfe; --color-end: #00f2fe; }
