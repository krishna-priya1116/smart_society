                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-card-header">
                                <div>
                                    <div class="stat-card-value">
                                        <field name="total_notices" readonly="1"/>
                                    </div>
                                    <div class="stat-card-label">Total Notices</div>
                                    <div class="stat-card-desc">Active &amp; Archived</div>
                                </div>
                                <div class="stat-card-icon" icon="fa-list-ul"/>
                            </div>
                        </div>
                        <div class="stat-card">
