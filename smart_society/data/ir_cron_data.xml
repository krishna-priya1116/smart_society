<odoo>
    <record id="ir_cron_generate_maintenance_bill" model="ir.cron">
        <field name="name">Generate Monthly Maintenance Bills</field>
        <field name="model_id" ref="model_maintenance_bill"/>
        <field name="state">code</field>
        <field name="code">model.generate_monthly_bills()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active">True</field>
    </record>
</odoo>