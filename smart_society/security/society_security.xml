<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="res_groups_privilege_society" model="res.groups.privilege">
            <field name="name">Smart Society</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_registration_user" model="res.groups">
            <field name="name">Resident</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="smart_society.res_groups_privilege_society"/>
        </record>

        <record id="group_registration_security" model="res.groups">
            <field name="name">Security</field>
            <field name="sequence">40</field>
            <field name="privilege_id" ref="smart_society.res_groups_privilege_society"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>

        </record>

        <record id="group_registration_committee" model="res.groups">
            <field name="name">Society Committee</field>
            <field name="sequence">50</field>
            <field name="privilege_id" ref="smart_society.res_groups_privilege_society"/>
             <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_registration_tower_committee" model="res.groups">
            <field name="name">Tower Committee</field>
            <field name="sequence">60</field>
            <field name="privilege_id" ref="smart_society.res_groups_privilege_society"/>
            <field name="implied_ids" eval="[(4,ref('base.group_user'))]"/>
        </record>

        <record id="group_registration_block_committee" model="res.groups">
            <field name="name">Block Committee</field>
            <field name="sequence">70</field>
            <field name="privilege_id" ref="smart_society.res_groups_privilege_society"/>
            <field name="implied_ids" eval="[(4,ref('base.group_user'))]"/>
        </record>

        <record id="group_registration_administration" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">80</field>
            <field name="privilege_id" ref="smart_society.res_groups_privilege_society"/>
            <field name="implied_ids" eval="[
                        (4, ref('smart_society.group_registration_user')),
                        (4, ref('smart_society.group_registration_security')),
                        (4, ref('smart_society.group_registration_committee')),
                        (4, ref('smart_society.group_registration_tower_committee')),
                        (4, ref('smart_society.group_registration_block_committee')),

                   ]"/>
            <field name="user_ids" eval="[
                    (4, ref('base.user_root')),(4, ref('base.user_admin'))
               ]"/>
        </record>

<!--        <record id="rule_resident_own_maintenance" model="ir.rule">-->
<!--            <field name="name">Resident Own Maintenance</field>-->
<!--            <field name="model_id" ref="model_society_maintenance"/>-->
<!--            <field name="groups" eval="[(4, ref('smart_society.group_registration_user'))]"/>-->
<!--            <field name="domain_force">[('flat_id.flat_member_ids.user_id', '=', user.id)]</field>-->
<!--        </record>-->


    </data>
</odoo>


